{
  "name": "tectique",
  "version": "0.9.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "workspaces": [
    "server"
  ],
  "scripts": {
    "setup": "npm ci && npm ci --prefix frontend",
    "dev": "tsx scripts/dev.ts",
    "build": "npm run build -w server && npm run build --prefix frontend",
    "test": "tsx scripts/test.ts",
    "start": "tsx scripts/start.ts",
    "test:unit": "tsx --test server/test/unit.test.ts server/test/engine-unit.test.ts frontend/test/editor-model.test.ts server/test/connections.test.ts"
  },
  "devDependencies": {
    "tsx": "^4.20.0",
    "embedded-postgres": "18.4.0-beta.17"
  }
}
